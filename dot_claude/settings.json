{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(BASE_REF=origin/main ./gradlew -q dirtyProjects)",
      "Bash(BASE_REF=origin/main ./gradlew -q deployableServices)",
      "WebSearch",
      "WebFetch(domain:docs.slack.dev)",
      "Bash(cat:*)",
      "Bash(mise run:*)",
      "WebFetch(domain:protobuf.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:buf.build)",
      "Bash(mise exec:*)",
      "Bash(find:*)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:openapi-generator.tech)",
      "Bash(ls:*)",
      "Bash(xargs:*)",
      "Bash(grep:*)",
      "WebFetch(domain:hk.jdx.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:habr.com)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "plan"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read file_path; touch \"$file_path\" 2>/dev/null & }"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/jarvis/.claude/statusline-command.sh"
  },
  "alwaysThinkingEnabled": true
}
