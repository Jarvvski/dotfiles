version = 2
final_space = true
console_title_template = ' {{ .Folder }} :: {{if .Root}}Admin{{end}}'
terminal_background = 'p:t-background'
disable_notice = true
auto_upgrade = false

[[blocks]]
  type = 'prompt'
  alignment = 'left'

  [[blocks.segments]]
    type = 'text'
    style = 'plain'
    template = '''
            {{- if matchP "^~/Code(/|$)" .PWD -}}
              in 
            {{- else if matchP "^~/Documents(/|$)" .PWD -}}
              in 󱔗
            {{- else if matchP "^~/Pictures(/|$)" .PWD -}}
              in 
            {{- else if matchP "^~/Desktop(/|$)" .PWD -}}
              in 
            {{- else if matchP "^~/Movies(/|$)" .PWD -}}
              in 󰿎
            {{- else -}}
            {{ "in" }}
            {{- end }} '''
    background = 'transparent'
    foreground = 'p:terminal-blue'

#   [[blocks.segments]]
#     type = 'path'
#     style = 'plain'
#     template = '''
#             {{- if matchP "^~/Code(/|$)" .PWD -}}
#               <p:terminal-blue>in  </><b>{{ trimPrefix "/" .Path }}</b>
#             {{- else if matchP "^~/Documents(/|$)" .PWD -}}
#               <p:terminal-blue>in 󱔗</> <b>{{trimPrefix "/" .Path }}</b>
#             {{- else if matchP "^~/Pictures(/|$)" .PWD -}}
#               <p:terminal-blue>in </> <b>{{ trimPrefix "/" .Path }}</b>
#             {{- else if matchP "^~/Desktop(/|$)" .PWD -}}
#               <p:terminal-blue>in </> <b>{{ trimPrefix "/" .Path }}</b>
#             {{- else if matchP "^~/Movies(/|$)" .PWD -}}
#               <p:terminal-blue>in 󰿎</> <b>{{ trimPrefix "/" .Path }}</b>
#             {{- else if matchP "^~/?$" .PWD -}}
#             <p:terminal-blue>in </><b>{{ trimPrefix "/" .Path }}</b>
#             {{- else -}}
#             <p:terminal-blue>in </><b>{{ .Path }}</b>
#             {{- end -}} '''
#     foreground = 'p:terminal-magenta'

  [[blocks.segments]]
    type = 'path'
    style = 'plain'
    template = '<b>{{ trimPrefix "/" .Path }}</b>'
    foreground = 'p:terminal-magenta'

    [blocks.segments.properties]
      style = 'agnoster_short'
      hide_root_location = true
      max_depth = 2
      folder_icon = ''

#   [[blocks.segments]]
#     type = 'git'
#     style = 'plain'
#     foreground_templates = ['{{ if or (.Working.Changed) (.Staging.Changed) }}p:terminal-red{{ end }}', '{{ if and (gt .Ahead 0) (gt .Behind 0)}}p:light-sky-blue {{ end }}', '{{ if gt .Ahead 0 }}p:terminal-blue{{ end }}', '{{ if gt .Behind 0 }}p:celeste-blue{{ end }}']
#     # template = ' <p:light-sky-blue>⚡</>({{ .HEAD}})'
#     template = ' ({{ .HEAD}})'
#     foreground = 'p:light-sky-blue'

#     [blocks.segments.properties]
#       branch_icon = ' '
#       fetch_status = true

  [[blocks.segments]]
    type = 'status'
    style = 'plain'
    template = ' '
    foreground = 'p:terminal-red'

[[blocks]]
  type = 'prompt'
  alignment = 'right'
  overflow = 'hide'

#   [[blocks.segments]]
#     type = 'node'
#     style = 'plain'
#     template = ' {{ .Full }} '
#     foreground = 'p:pistachio-green'

#   [[blocks.segments]]
#     type = 'php'
#     style = 'plain'
#     template = ' {{ .Full }} '
#     foreground = 'p:terminal-blue'

#   [[blocks.segments]]
#     type = 'python'
#     style = 'plain'
#     template = ' {{ .Full }}'
#     foreground = 'p:terminal-yellow'

#   [[blocks.segments]]
#     type = 'julia'
#     style = 'plain'
#     template = ' {{ .Full }}'
#     foreground = 'p:terminal-magenta'

#   [[blocks.segments]]
#     type = 'kotlin'
#     style = 'plain'
#     template = '󱈙 {{ .Full }}'
#     foreground = 'p:terminal-magenta'

#     [blocks.segments.properties]
#       display_mode = 'context'

#   [[blocks.segments]]
#     type = 'ruby'
#     style = 'plain'
#     template = ' {{ .Full}}'
#     foreground = 'p:terminal-red'

#   [[blocks.segments]]
#     type = 'go'
#     style = 'plain'
#     template = 'ﳑ {{ .Full}}'
#     foreground = 'p:light-sky-blue'

  [[blocks.segments]]
    type = 'command'
    style = 'plain'
    foreground = 'p:white-blue'

    [blocks.segments.properties]
      command = 'git log --pretty=format:%cr -1 || date +%H:%M:%S'
      shell = 'bash'

[[blocks]]
  type = 'prompt'
  alignment = 'left'
  newline = true

  [[blocks.segments]]
    type = 'text'
    style = 'plain'
    template = ' 󱞩'
    foreground = 'p:pistachio-green'

[transient_prompt]
  template = '➜ '
  background = 'transparent'
  foreground = 'p:terminal-blue'

[secondary_prompt]
  template = ' ➜ '
  background = 'transparent'
  foreground = 'p:terminal-blue'

[palette]
  blue-bell = '#9aa5ce'
  blue-black = '#565f89'
  celeste-blue = '#b4f9f8'
  light-sky-blue = '#7dcfff'
  main-bg = '#24283b'
  pastal-grey = '#cfc9c2'
  pistachio-green = '#9ece6a'
  t-background = 'p:main-bg'
  terminal-black = '#414868'
  terminal-blue = '#7aa2f7'
  terminal-green = '#73daca'
  terminal-magenta = '#bb9af7'
  terminal-red = '#f7768e'
  terminal-white = '#c0caf5'
  terminal-yellow = '#e0af68'
  white-blue = '#a9b1d6'
