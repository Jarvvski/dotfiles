hs.configdir = '/Users/jarvis/.config/hammerspoon'
package.path = hs.configdir .. '/?.lua;' .. hs.configdir .. '/?/init.lua;' .. hs.configdir .. '/Spoons/?.spoon/init.lua;' .. package.path

package.path = table.concat({
    package.path,
    hs.configdir..'/Spoons/?.spoon/init.lua',
}, ';')


hs.hotkey.bind({"cmd"}, "escape", function()
    createOrLaunch()
end)

local log = hs.logger.new('dropdown-term', 'info')

function isempty(s)
  return s == nil or s == ''
end

function createOrLaunch()
    local bundleId ="com.github.wez.wezterm"
	local app = hs.application.get(bundleId)
	local currentSpace = hs.spaces.focusedSpace()
    local wf=hs.window.filter

    function createNewWindow()
        app:selectMenuItem({"Shell", "New Window"})
        log.i("Created new window")
        local window
        hs.timer.doAfter(1, function()
            window = findWindows()[1]

            -- if newWindow then
            --     -- newWindow:moveToUnit'[100,50,0,0]'
            --     log.i("Moved new window to position")
            -- else
            --     log.i("Could not find window after creating a new one")
            -- end
        end)
        return window
    end

    function findOrCreateDropdownWindow()
        local wf_terminal = wf.new(false):setAppFilter(bundleId)
        local windows = wf_terminal:getWindows()
        if #windows > 0 then
            log.i("Found " .. #windows .. " windows")
            return windows
        else
            log.i("Did not find any windows. Creating a new one.")
            local window = createNewWindow()
            window:focus()
            -- Optionally, return the new window after a short delay
            hs.timer.doAfter(, function()
                local newWindows = wf_terminal:getWindows()
                if #newWindows > 0 then
                    log.i("New window successfully created")
                    return newWindows
                else
                    log.i("Failed to create a new window")
                end
            end)
        end
    end

    function findWindows()
        local filter = wf.new(false):setAppFilter('WezTerm')
        return filter:getWindows()
    end

    log.i("Looking for existing windows")
    local window = findOrCreateDropdownWindow()

    -- if isempty(window) then
