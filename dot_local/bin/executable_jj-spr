#!/usr/bin/env bun

/**
 * jj-pr-stack: A simple tool to manage stacked PRs with Jujutsu
 *
 * Updates PR body with stack navigation (no comments, no footer)
 */

import { $ } from "bun";
import React, { useState, useEffect } from "react";
import { render, Text, Box } from "ink";
import Link from "ink-link";
import { Spinner } from "@inkjs/ui";

// Types
interface Bookmark {
  name: string;
  commitId: string;
  changeId: string;
  hasRemote: boolean;
}

interface StackEntry {
  bookmark: Bookmark;
  parent?: string; // parent bookmark name
  prNumber?: number;
  prUrl?: string;
}

interface PRInfo {
  number: number;
  html_url: string;
  body: string;
  head: string;
  base: string;
}

// GitHub API helpers using gh CLI
async function ghApi<T>(endpoint: string, method = "GET", data?: object): Promise<T> {
  const args = ["gh", "api", endpoint, "-X", method];
  if (data) {
    args.push("--input", "-");
    const proc = Bun.spawn(args, {
      stdin: "pipe",
      stdout: "pipe",
      stderr: "pipe",
    });
    proc.stdin.write(JSON.stringify(data));
    proc.stdin.end();
    const output = await new Response(proc.stdout).text();
    const exitCode = await proc.exited;
    if (exitCode !== 0) {
      const stderr = await new Response(proc.stderr).text();
      throw new Error(`gh api failed: ${stderr}`);
    }
    return JSON.parse(output);
  } else {
    const result = await $`gh api ${endpoint} -X ${method}`.text();
    return JSON.parse(result);
  }
}

async function getRepoInfo(): Promise<{ owner: string; repo: string }> {
  const result = await $`jj git remote list`.nothrow().quiet();
  const output = result.stdout.toString();
  const match = output.match(/github\.com[:/]([^/]+)\/([^/.]+)/);
  if (!match) throw new Error("Could not parse GitHub remote URL");
  return { owner: match[1], repo: match[2].replace(/\.git$/, "") };
}

async function getDefaultBranch(): Promise<string> {
  const { owner, repo } = await getRepoInfo();
  const repoData = await ghApi<{ default_branch: string }>(`repos/${owner}/${repo}`);
  return repoData.default_branch;
}

async function findPRForBranch(branch: string): Promise<PRInfo | null> {
  const { owner, repo } = await getRepoInfo();
  try {
    const prs = await ghApi<PRInfo[]>(
      `repos/${owner}/${repo}/pulls?head=${owner}:${branch}&state=open`
    );
    if (prs.length > 0) {
      return prs[0];
    }
  } catch {
    // No PR found
  }
  return null;
}

async function createPR(
  head: string,
  base: string,
  title: string,
  body: string,
  draft: boolean = true
): Promise<PRInfo> {
  const { owner, repo } = await getRepoInfo();
  return ghApi<PRInfo>(`repos/${owner}/${repo}/pulls`, "POST", {
    head,
    base,
    title,
    body,
    draft,
  });
}

async function updatePR(prNumber: number, updates: { body?: string; base?: string }): Promise<void> {
  const { owner, repo } = await getRepoInfo();
  await ghApi(`repos/${owner}/${repo}/pulls/${prNumber}`, "PATCH", updates);
}

// JJ helpers
async function getBookmarks(): Promise<Bookmark[]> {
  const result = await $`jj bookmark list -r "mine() ~ trunk()"`.nothrow().quiet();
  const output = result.stdout.toString();

  const bookmarks: Map<string, Bookmark> = new Map();

  for (const line of output.trim().split("\n")) {
    if (!line.trim()) continue;
    // Skip indented lines (remote tracking info)
    if (line.startsWith(" ")) continue;

    // Format: "bookmark_name: change_id commit_id description"
    const match = line.match(/^([^:]+):\s+(\w+)\s+(\w+)/);
    if (!match) continue;

    const [, name, changeId, commitId] = match;

    bookmarks.set(name, {
      name,
      commitId,
      changeId,
      hasRemote: false,
    });
  }

  return Array.from(bookmarks.values());
}

async function getBookmarkStack(targetBookmark: string): Promise<string[]> {
  // Get all bookmarks in the full stack (ancestors AND descendants)
  // Returns them in order from bottom (closest to trunk) to top
  const template = `
    bookmarks.map(|b| b.name() ++ "\\n")
  `.trim();

  // First find the tip of the stack (highest descendant that has a bookmark)
  let tipOutput: string;
  try {
    tipOutput = await $`jj log -r "heads(${targetBookmark}:: & bookmarks() & mine())" --no-graph -T ${template}`.text();
  } catch {
    tipOutput = targetBookmark;
  }
  const tip = tipOutput.trim().split("\n").filter((l) => l.trim())[0] || targetBookmark;

  // Now get the full stack from trunk to tip
  let output: string;
  try {
    output = await $`jj log -r "trunk()::${tip} ~ trunk()" --no-graph -T ${template}`.text();
  } catch {
    return [targetBookmark];
  }

  const bookmarkNames = output
    .trim()
    .split("\n")
    .filter((line) => line.trim())
    .reverse(); // reverse to get bottom-to-top order

  // Deduplicate while preserving order
  const seen = new Set<string>();
  const result: string[] = [];
  for (const name of bookmarkNames) {
    if (!seen.has(name)) {
      seen.add(name);
      result.push(name);
    }
  }

  return result.length > 0 ? result : [targetBookmark];
}

async function getCommitInfo(bookmarkName: string): Promise<{ title: string; body: string }> {
  // Get the commit message for the bookmark
  const template = `description`;
  const result = await $`jj log -r ${bookmarkName} --no-graph -T ${template}`.nothrow().quiet();
  const output = result.stdout.toString().trim();

  if (!output) {
    return { title: bookmarkName, body: "" };
  }

  // Split into title (first line) and body (rest)
  const lines = output.split("\n");
  const title = lines[0] || bookmarkName;
  const body = lines.slice(1).join("\n").trim();

  return { title, body };
}

function generateStackSection(
  stack: StackEntry[],
  currentBookmark: string
): string {
  const lines: string[] = ["## Stack", ""];

  for (const entry of stack) {
    if (!entry.prNumber) continue;
    const isCurrent = entry.bookmark.name === currentBookmark;
    const prefix = isCurrent ? "👉🏻 " : "";
    lines.push(`- ${prefix}#${entry.prNumber}`);
  }

  return lines.join("\n");
}

function updateBodyWithStack(existingBody: string, stackSection: string): string {
  // Remove existing stack section if present
  const stackRegex = /## Stack\n[\s\S]*?(?=\n## |\n*$)/;
  const cleanBody = existingBody.replace(stackRegex, "").trim();

  // Add new stack section at the end
  if (cleanBody) {
    return `${cleanBody}\n\n${stackSection}`;
  }
  return stackSection;
}

async function pushBookmark(bookmarkName: string): Promise<void> {
  await $`jj git push -b ${bookmarkName}`.quiet();
}

async function submit(targetBookmark: string, dryRun: boolean): Promise<void> {
  const bookmarks = await getBookmarks();
  const bookmarkMap = new Map(bookmarks.map((b) => [b.name, b]));

  if (!bookmarkMap.has(targetBookmark)) {
    console.error(`Bookmark '${targetBookmark}' not found`);
    console.error("Available bookmarks:", bookmarks.map((b) => b.name).join(", "));
    process.exit(1);
  }

  // Get the stack for this bookmark
  const stackNames = await getBookmarkStack(targetBookmark);

  // Build stack entries and initial items for UI
  const stack: StackEntry[] = [];
  const items: SubmitItem[] = [];

  for (const name of stackNames) {
    const bookmark = bookmarkMap.get(name);
    if (!bookmark) continue;

    const pr = await findPRForBranch(name);
    stack.push({
      bookmark,
      prNumber: pr?.number,
      prUrl: pr?.html_url,
    });
    items.push({
      name,
      prNumber: pr?.number,
      prUrl: pr?.html_url,
      status: "pending",
      isNew: !pr,
    });
  }

  const defaultBranch = await getDefaultBranch();

  // Render UI
  const { rerender, unmount } = render(
    <SubmitUI items={items} stackNames={stackNames} dryRun={dryRun} />
  );

  // Process each bookmark in the stack
  for (let i = 0; i < stack.length; i++) {
    const entry = stack[i];
    const item = items[i];
    const baseBranch = i === 0 ? defaultBranch : stack[i - 1].bookmark.name;

    try {
      // Push the bookmark
      item.status = "pushing";
      rerender(<SubmitUI items={items} stackNames={stackNames} dryRun={dryRun} />);

      if (!dryRun) {
        await pushBookmark(entry.bookmark.name);
      }

      // Generate stack section for this PR
      const stackSection = generateStackSection(stack, entry.bookmark.name);

      if (entry.prNumber) {
        // Update existing PR
        item.status = "updating_pr";
        rerender(<SubmitUI items={items} stackNames={stackNames} dryRun={dryRun} />);

        if (!dryRun) {
          const existingPR = await findPRForBranch(entry.bookmark.name);
          const newBody = updateBodyWithStack(existingPR?.body || "", stackSection);
          await updatePR(entry.prNumber, { body: newBody, base: baseBranch });
        }
      } else {
        // Create new PR
        item.status = "creating_pr";
        rerender(<SubmitUI items={items} stackNames={stackNames} dryRun={dryRun} />);

        // Get commit info for PR title and body
        const commitInfo = await getCommitInfo(entry.bookmark.name);
        const title = commitInfo.title;
        const body = commitInfo.body
          ? `${commitInfo.body}\n\n${stackSection}`
          : stackSection;

        if (!dryRun) {
          const pr = await createPR(entry.bookmark.name, baseBranch, title, body, true);
          entry.prNumber = pr.number;
          entry.prUrl = pr.html_url;
          item.prNumber = pr.number;
          item.prUrl = pr.html_url;
        }
      }

      item.status = "done";
      rerender(<SubmitUI items={items} stackNames={stackNames} dryRun={dryRun} />);
    } catch (e) {
      item.status = "failed";
      item.error = e instanceof Error ? e.message : "Unknown error";
      rerender(<SubmitUI items={items} stackNames={stackNames} dryRun={dryRun} />);
    }
  }

  // Second pass: update all PRs with complete stack info (now that all PRs exist)
  if (!dryRun) {
    for (const item of items) {
      if (item.prNumber && item.status === "done") {
        item.status = "updating_stack";
        rerender(<SubmitUI items={items} stackNames={stackNames} dryRun={dryRun} />);

        try {
          const entry = stack.find((s) => s.bookmark.name === item.name);
          if (entry) {
            const stackSection = generateStackSection(stack, entry.bookmark.name);
            const existingPR = await findPRForBranch(entry.bookmark.name);
            const newBody = updateBodyWithStack(existingPR?.body || "", stackSection);
            await updatePR(entry.prNumber!, { body: newBody });
          }
          item.status = "done";
        } catch (e) {
          item.status = "failed";
          item.error = e instanceof Error ? e.message : "Unknown error";
        }
        rerender(<SubmitUI items={items} stackNames={stackNames} dryRun={dryRun} />);
      }
    }
  }

  unmount();
}

async function getCurrentBookmark(): Promise<string | null> {
  const result = await $`jj log -r @ --no-graph -T 'bookmarks'`.nothrow().quiet();
  const output = result.stdout.toString().trim();
  if (!output) return null;
  // Take first bookmark if multiple, strip status suffixes (* for unpushed, @ for current, etc.)
  return output.split(/\s+/)[0].replace(/[*@?!]+$/, '');
}

// Ink UI for sync progress
type SyncStatus = "pending" | "syncing" | "done" | "failed" | "skipped";

interface SyncItem {
  name: string;
  prNumber?: number;
  prUrl?: string;
  status: SyncStatus;
  error?: string;
}

function SyncUI({ items, dryRun }: { items: SyncItem[]; dryRun: boolean }) {
  return (
    <Box flexDirection="column">
      <Text>{dryRun ? "Sync PRs (dry-run):" : "Syncing PRs:"}</Text>
      {items.map((item) => (
        <Box key={item.name}>
          <Text>  </Text>
          {item.status === "syncing" && <><Spinner label="" /><Text> </Text></>}
          {item.status === "done" && <Text color="green">✓ </Text>}
          {item.status === "failed" && <Text color="red">✗ </Text>}
          {item.status === "pending" && <Text color="gray">· </Text>}
          {item.status === "skipped" && <Text color="gray">· </Text>}
          <Text
            color={
              item.status === "done" ? "green" :
              item.status === "failed" ? "red" :
              (item.status === "pending" || item.status === "skipped") ? "gray" :
              undefined
            }
          >
            {item.name}
            {item.prNumber && item.prUrl ? (
              <> <Text color="blue"><Link url={item.prUrl}>#{item.prNumber}</Link></Text></>
            ) : item.prNumber ? ` #${item.prNumber}` : ""}
            {item.error ? ` - ${item.error}` : ""}
          </Text>
        </Box>
      ))}
    </Box>
  );
}

// Ink UI for submit progress
type SubmitStatus = "pending" | "pushing" | "creating_pr" | "updating_pr" | "updating_stack" | "done" | "failed";

interface SubmitItem {
  name: string;
  prNumber?: number;
  prUrl?: string;
  status: SubmitStatus;
  isNew: boolean;
  error?: string;
}

function SubmitUI({ items, stackNames, dryRun }: {
  items: SubmitItem[];
  stackNames: string[];
  dryRun: boolean;
}) {
  const stackDisplay = stackNames.join(" → ");

  return (
    <Box flexDirection="column">
      <Text color="gray">{dryRun ? "(dry-run) " : ""}Stack: {stackDisplay}</Text>
      <Text> </Text>
      {items.map((item) => {
        let statusIcon: React.ReactNode;
        let statusText = "";

        switch (item.status) {
          case "pending":
            statusIcon = <Text color="gray">· </Text>;
            break;
          case "pushing":
            statusIcon = <><Spinner label="" /><Text> </Text></>;
            statusText = " (pushing...)";
            break;
          case "creating_pr":
            statusIcon = <><Spinner label="" /><Text> </Text></>;
            statusText = " (creating PR...)";
            break;
          case "updating_pr":
            statusIcon = <><Spinner label="" /><Text> </Text></>;
            statusText = " (updating PR...)";
            break;
          case "updating_stack":
            statusIcon = <><Spinner label="" /><Text> </Text></>;
            statusText = " (updating stack links...)";
            break;
          case "done":
            statusIcon = <Text color="green">✓ </Text>;
            break;
          case "failed":
            statusIcon = <Text color="red">✗ </Text>;
            break;
        }

        const color =
          item.status === "done" ? "green" :
          item.status === "failed" ? "red" :
          item.status === "pending" ? "gray" :
          undefined;

        return (
          <Box key={item.name}>
            <Text>  </Text>
            {statusIcon}
            <Text color={color}>
              {item.name}
              {item.prNumber && item.prUrl ? (
                <> <Text color="blue"><Link url={item.prUrl}>#{item.prNumber}</Link></Text></>
              ) : item.prNumber ? ` #${item.prNumber}` : ""}
              {item.isNew && item.status === "done" && !item.prUrl ? " (new)" : ""}
              {statusText}
              {item.error ? ` - ${item.error}` : ""}
            </Text>
          </Box>
        );
      })}
      <Text> </Text>
    </Box>
  );
}

async function syncAll(dryRun: boolean): Promise<void> {
  const bookmarks = await getBookmarks();

  if (bookmarks.length === 0) {
    console.log("No bookmarks found");
    return;
  }

  // Build initial items list (parallel PR lookups)
  const items: SyncItem[] = await Promise.all(
    bookmarks.map(async (bookmark) => {
      const pr = await findPRForBranch(bookmark.name);
      return {
        name: bookmark.name,
        prNumber: pr?.number,
        prUrl: pr?.html_url,
        status: pr ? "pending" : "skipped",
      } as SyncItem;
    })
  );

  // Render UI
  const { rerender, unmount } = render(<SyncUI items={items} dryRun={dryRun} />);

  // Mark all items with PRs as syncing
  for (const item of items) {
    if (item.status !== "skipped") {
      item.status = "syncing";
    }
  }
  rerender(<SyncUI items={items} dryRun={dryRun} />);

  // Process all bookmarks in parallel
  await Promise.all(
    items.map(async (item) => {
      if (item.status === "skipped") return;

      try {
        const bookmark = bookmarks.find((b) => b.name === item.name)!;
        const pr = await findPRForBranch(bookmark.name);
        if (!pr) {
          item.status = "skipped";
          rerender(<SyncUI items={items} dryRun={dryRun} />);
          return;
        }

        const stackNames = await getBookmarkStack(bookmark.name);
        const stack: StackEntry[] = (
          await Promise.all(
            stackNames.map(async (name) => {
              const b = bookmarks.find((bm) => bm.name === name);
              if (!b) return null;
              const prInfo = await findPRForBranch(name);
              return {
                bookmark: b,
                prNumber: prInfo?.number,
                prUrl: prInfo?.html_url,
              };
            })
          )
        ).filter((entry): entry is StackEntry => entry !== null);

        const stackSection = generateStackSection(stack, bookmark.name);
        const newBody = updateBodyWithStack(pr.body || "", stackSection);

        if (!dryRun) {
          await updatePR(pr.number, { body: newBody });
        }

        item.status = "done";
      } catch (e) {
        item.status = "failed";
        item.error = e instanceof Error ? e.message : "Unknown error";
      }

      rerender(<SyncUI items={items} dryRun={dryRun} />);
    })
  );

  unmount();

  const doneCount = items.filter((i) => i.status === "done").length;
  const failedCount = items.filter((i) => i.status === "failed").length;

  if (doneCount > 0 || failedCount > 0) {
    console.log(`\n${dryRun ? "Would sync" : "Synced"} ${doneCount} PR(s)${failedCount > 0 ? `, ${failedCount} failed` : ""}`);
  }
}

async function listStack(targetBookmark?: string): Promise<void> {
  const bookmarks = await getBookmarks();

  if (bookmarks.length === 0) {
    console.log("No bookmarks found between trunk and your changes");
    return;
  }

  if (targetBookmark) {
    const stackNames = await getBookmarkStack(targetBookmark);
    console.log(`Stack for ${targetBookmark}:`);
    console.log("  trunk");
    for (const name of stackNames) {
      const bookmark = bookmarks.find((b) => b.name === name);
      const remote = bookmark?.hasRemote ? " (pushed)" : "";
      const current = name === targetBookmark ? " ← target" : "";
      console.log(`  ↳ ${name}${remote}${current}`);
    }
  } else {
    console.log("Bookmarks:");
    for (const bookmark of bookmarks) {
      const remote = bookmark.hasRemote ? " (pushed)" : "";
      console.log(`  ${bookmark.name}${remote}`);
    }
  }
}

// CLI
const args = process.argv.slice(2);
const command = args[0];
const dryRun = args.includes("--dry-run") || args.includes("-n");

if (command === "submit" || command === "s") {
  const bookmark = args.find((a) => !a.startsWith("-") && a !== "submit" && a !== "s");

  if (!bookmark) {
    console.error("Usage: jj-pr-stack submit <bookmark> [--dry-run]");
    process.exit(1);
  }

  await submit(bookmark, dryRun);
} else if (command === "list" || command === "ls") {
  const bookmark = args.find((a) => !a.startsWith("-") && a !== "list" && a !== "ls");
  await listStack(bookmark);
} else if (command === "sync") {
  await syncAll(dryRun);
} else if (command === "help" || command === "-h" || command === "--help") {
  console.log(`jj-pr-stack - Manage stacked PRs with Jujutsu

Usage:
  jj-pr-stack                       Submit PRs for current bookmark's stack
  jj-pr-stack --dry-run             Dry run for current bookmark
  jj-pr-stack list [bookmark]       List bookmarks or show stack
  jj-pr-stack submit <bookmark>     Submit PRs for specified bookmark's stack
  jj-pr-stack sync                  Update all existing PRs with stack info

Options:
  -n, --dry-run    Show what would happen without making changes
  -h, --help       Show this help message
`);
} else if (!command || command.startsWith("-")) {
  // No command or just flags - submit current bookmark
  const bookmark = await getCurrentBookmark();
  if (!bookmark) {
    console.error("No bookmark on current revision. Create one with: jj bc");
    process.exit(1);
  }
  await submit(bookmark, dryRun);
} else {
  console.error(`Unknown command: ${command}`);
  console.error("Run 'jj-pr-stack help' for usage");
  process.exit(1);
}
