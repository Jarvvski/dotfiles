# ignore chezmoi db (lol)
.config/chezmoi/chezmoistate.boltdb

# Ignore ZCommet compiled files
*.zwc
*.zsh.zwc
.config/zsh/.zcomet/
.config/zsh/.zcompdump_*
.config/zsh/.zcompcache/
.config/zsh/*.zwc
.config/zsh/modules/*.zwc

# Ignore everything in .config/colima/
.config/colima/**
# Allow traversal into any subdirectory
!.config/colima/*/
# Allow any colima.yaml file in subdirectories
!.config/colima/*/colima.yaml

# Ignore any gcloud stuff
.config/gcloud/

# Ignore any random fish (I don't use fish currently)
.config/fish

# Ignore karabiner generated dirs
.config/karabiner/assets/
.config/karabiner/automatic_backups/

# GPG conf
.gnupg/private-keys-v1.d/
.gnupg/public-keys.d/
.gnupg/reader_0.status
.gnupg/S.gpg-agent/
.gnupg/S.gpg-agent.browser/
.gnupg/S.gpg-agent.extra/
.gnupg/S.gpg-agent.ssh/
.gnupg/S.keyboxd/
.gnupg/S.scdaemon/
.gnupg/trustdb.gpg
.gnupg/sshcontrol

# Ignore these entirely
.config/ldcli/
.config/software/
.config/tmux/
.config/uv/
.config/composer/
.config/docker/
.config/gh/
.config/iterm2/
